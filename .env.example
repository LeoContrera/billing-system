# Django Configuration
# ====================

# SECURITY WARNING: Keep the secret key secret in production!
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-eis(bc^s%%ejqd1w!0c^r+oq48%q*o=5ns16zg7lw=v8vp8ctc

# SECURITY WARNING: Don't run with debug turned on in production!
# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
# Example: example.com,www.example.com,api.example.com
ALLOWED_HOSTS=localhost,127.0.0.1


# AFIP Configuration
# ==================

# Set to True for development (simulated CAE, no AFIP contact)
# Set to False for production (contacts real AFIP WSFE)
AFIP_DEBUG_MODE=True


# Email Configuration
# ===================

# Email backend
# Development: django.core.mail.backends.console.EmailBackend (prints to console)
# Production: django.core.mail.backends.smtp.EmailBackend (sends real emails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Configuration (only needed if using smtp backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Email credentials (required for production)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Default sender email address
DEFAULT_FROM_EMAIL=noreply@billing-system.local


# Database Configuration
# ======================
# By default, SQLite is used (configured in settings.py)
# For production, you may want to use PostgreSQL or MySQL
# Uncomment and configure if needed:
# DATABASE_URL=postgres://user:password@localhost:5432/dbname


# Notes
# =====
# 1. Copy this file to .env and fill in your values
# 2. The .env file is gitignored and should NEVER be committed
# 3. In production, use environment variables instead of .env files
# 4. All settings have safe defaults for development
