@startuml "Diagrama de Estructura - Datos Obligatorios ARCA"
skinparam style strictuml

class ComprobanteLocal {
    - puntoVenta: Integer
    - tipoComprobante: Integer
    - concepto: Integer
    - tipoDocumentoReceptor: Integer
    - numeroDocumentoReceptor: String
    - fechaComprobante: Date
    - importeNeto: Decimal
    - importeIva: Decimal
    - importeTotal: Decimal
    - monedaId: String
    - cotizacion: Decimal
    + validarConsistencia(): Boolean
}

note right of ComprobanteLocal::validarConsistencia
  Asegura que:
  Total = Neto + IVA + Tributos
end note
@enduml