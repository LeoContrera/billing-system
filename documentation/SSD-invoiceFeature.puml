@startuml "SSD - Emitir Comprobante con Validación ARCA"
skinparam style strictuml
actor Vendedor
participant Sistema

Vendedor -> Sistema : iniciarVenta(datosCliente, items)
activate Sistema
Sistema --> Vendedor : mostrarPrevisualizacion(total, impuestos)
deactivate Sistema

Vendedor -> Sistema : confirmarVenta()
activate Sistema
Sistema -> Sistema : crearComprobanteLocal()
note right: El sistema persiste la factura\nen estado 'Pendiente'

Sistema -> ARCA : solicitarAutorizacion(comprobante)
activate ARCA
ARCA --> Sistema : retornarCAE(numeroCAE, vencimiento)
deactivate ARCA

Sistema -> Sistema : actualizarEstadoComprobante(CAE)
Sistema --> Vendedor : imprimirFactura(comprobanteValidado)
deactivate Sistema
@enduml